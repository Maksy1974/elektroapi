// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Mahasiswa{
  id Int @id @default(autoincrement())
  nama String
  nim String @unique
  jurusan String 
  prodiId Int   
  foto String? 
  kartu KartuMahasiswa?
  krs Krs[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  prodi Prodi @relation(fields:[prodiId],references:[id])
}

model KartuMahasiswa{
  id Int @id @default(autoincrement())
  nomorKartu String
  mahasiswaId Int @unique
  mahasiswa Mahasiswa @relation(fields:[mahasiswaId],references:[id])
}

model Prodi{
  id Int @id @default(autoincrement())
  nama String
  mahasiswa Mahasiswa[]
}

model Matakuliah{
  id Int @id @default(autoincrement())
  nama String
  krs Krs[]
}

model Krs{
  id Int @id @default(autoincrement())
  mahasiswaId Int
  matakuliahId Int
  mahasiswa Mahasiswa @relation(fields:[mahasiswaId],references:[id])
  matakuliah Matakuliah @relation(fields:[matakuliahId],references:[id])

}
